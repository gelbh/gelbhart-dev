<% text_align = local_assigns.fetch(:text_align, 'center') %>
<% animation_delay = local_assigns.fetch(:animation_delay, '') %>
<% subtitle = local_assigns[:subtitle] %>

<div class="text-<%= text_align %> mb-5">
    <h2 class="h1 mb-3 fade-in-view reveal-heading <%= animation_delay %>"><%= title %></h2>
    <% if subtitle.present? %>
    <p class="fs-lg text-muted fade-in-view reveal-heading" style="--i: 1">
        <%= subtitle %>
    </p>
    <% end %>
</div>