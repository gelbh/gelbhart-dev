          { id: "overview", label: "Start", shots: [
            ["home", "Home screen with an active seeker session"],
            ["create-game-area-dublin", "Host framing the play area on the map before sharing a session code"],
            ["live-map", "Live map ready to start with question tools on the bottom bar"],
            ["tentacles-museum-pins", "Tentacles museum question with pins on the map ready to send"]
          ] },
          { id: "session", label: "Map", shots: [
            ["map-set-zone-confirm", "Hider confirming a 500 m hiding zone on the map"],
            ["map-hiding-play-move", "Hiding phase in progress with Play and Move controls on the map"],
            ["map-chat-game-feed", "Live game feed showing Matching, Measuring, and Radar answers"],
            ["map-role-codes", "Session role codes sheet for seekers and hiders"]
          ] },
          { id: "ask", label: "Ask", shots: [
            ["ask-tool", "Matching question on the map ready to send to hiders"],
            ["measuring-park-preview", "Measuring question preview with a park target on the map"],
            ["photo-ask-picker", "Photo ask tool picker for a visual question to hiders"],
            ["radar-distance-picker", "Radar tool distance picker for an inside-or-outside question"]
          ] },
          { id: "social", label: "Social", shots: [
            ["friends-list", "Friends list with online status and pending requests"],
            ["leaderboard-global-podium", "Global leaderboard podium ranked by hiding time"],
            ["stats-hider", "Hider stats with hiding time and game history"],
            ["custom-games-list", "Custom game presets list for quick session setup"]
          ] }
        ] %>
        <div class="jetlag-gallery-stage">
          <ul class="nav jetlag-gallery-tabs mb-4" id="jetlagGalleryTabs" role="tablist">
            <% jetlag_gallery.each_with_index do |group, i| %>
              <li class="nav-item" role="presentation">
                <button class="nav-link<%= " active" if i.zero? %>" id="jetlag-<%= group[:id] %>-tab" data-bs-toggle="tab" data-bs-target="#jetlag-<%= group[:id] %>-pane" type="button" role="tab" aria-controls="jetlag-<%= group[:id] %>-pane" aria-selected="<%= i.zero? %>"><%= group[:label] %></button>
              </li>
            <% end %>
          </ul>

          <div class="tab-content" id="jetlagGalleryTabContent">
            <% jetlag_gallery.each_with_index do |group, i| %>
              <div class="tab-pane fade<%= " show active" if i.zero? %>" id="jetlag-<%= group[:id] %>-pane" role="tabpanel" aria-labelledby="jetlag-<%= group[:id] %>-tab" tabindex="0">
                <div class="jetlag-gallery-grid">
                  <% group[:shots].each do |name, alt| %>
                    <button type="button"
                            class="gallery-item jetlag-phone-frame"
                            data-bs-toggle="modal"
                            data-bs-target="#jetlagImageModal"
                            data-image="<%= asset_path("jetlag/#{name}-full.webp") %>"
                            data-alt="<%= alt %>"
                            aria-label="Enlarge screenshot: <%= alt %>">
                      <%= image_tag "jetlag/#{name}.webp",
                            alt: alt,
                            class: "img-fluid",
                            srcset: "#{asset_path("jetlag/#{name}-400.webp")} 400w, #{asset_path("jetlag/#{name}.webp")} 800w",
                            sizes: "(min-width: 1400px) 18rem, (min-width: 1200px) 15rem, (min-width: 992px) 12.5rem, 45vw",
                            loading: "lazy",
                            width: 800,
                            height: 1734 %>
                      <span class="jetlag-gallery-zoom" aria-hidden="true">
                        <i class="bx bx-expand-alt"></i>
                      </span>
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="card jetlag-card border-0 shadow mb-4 fade-in-view delay-3">
        <div class="card-body p-4">
          <h2 class="h4 mb-3">Tech stack</h2>
          <div class="d-flex flex-wrap gap-2">
            <%= render "shared/tech_badge", text: "React", color: "primary", url: "https://react.dev/", extra_classes: "px-3 py-2" %>
            <%= render "shared/tech_badge", text: "Leaflet", color: "success", url: "https://leafletjs.com/", extra_classes: "px-3 py-2" %>
            <%= render "shared/tech_badge", text: "Firebase", color: "warning", url: "https://firebase.google.com/", extra_classes: "px-3 py-2" %>
            <%= render "shared/tech_badge", text: "Cloudflare Workers", color: "info", url: "https://workers.cloudflare.com/", extra_classes: "px-3 py-2" %>
            <%= render "shared/tech_badge", text: "PWA", color: "secondary", url: "https://web.dev/progressive-web-apps/", extra_classes: "px-3 py-2" %>
          </div>
        </div>
      </div>

      <div class="card jetlag-card border-0 shadow mb-4 fade-in-view delay-4">
        <div class="card-body p-4">
          <h2 class="h4 mb-3">FAQ</h2>
          <div class="accordion accordion-flush" id="jetlagFaq">
