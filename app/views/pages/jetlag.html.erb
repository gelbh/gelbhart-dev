                  <%= image_tag "jetlag/01-hero-map.webp",
                        alt: "Live seeker map with play zone, location, and hiding timer",
                        class: "img-fluid",
                        srcset: "#{asset_path('jetlag/01-hero-map-400.webp')} 400w, #{asset_path('jetlag/01-hero-map.webp')} 800w",
                        sizes: "(min-width: 992px) 20rem, min(100vw - 3rem, 18rem)",
                        loading: "lazy",
                        width: 800,
                        height: 1731 %>
                  <span class="jetlag-gallery-zoom" aria-hidden="true">
                    <i class="bx bx-expand-alt"></i>
                  </span>
                </button>
                <div class="jetlag-gallery-caption">
                  <h3 class="h5 mb-2">Live map</h3>
                  <p class="text-light opacity-75 mb-0">Mid-session map with zone state, HUD timers, and the tool dock.</p>
                </div>
              </div>
            </div>
            <div class="tab-pane fade" id="jetlag-answered-pane" role="tabpanel" aria-labelledby="jetlag-answered-tab" tabindex="0">
              <div class="jetlag-gallery-shot">
                <button type="button"
                        class="gallery-item jetlag-phone-frame"
                        data-bs-toggle="modal"
                        data-bs-target="#jetlagImageModal"
