                        srcset: "#{asset_path('jetlag/04-answered-400.webp')} 400w, #{asset_path('jetlag/04-answered.webp')} 800w",
                        sizes: "(min-width: 992px) 20rem, min(100vw - 3rem, 18rem)",
                        loading: "lazy",
                        width: 800,
                        height: 1731 %>
                  <span class="jetlag-gallery-zoom" aria-hidden="true">
                    <i class="bx bx-expand-alt"></i>
                  </span>
                </button>
                <div class="jetlag-gallery-caption">
                  <h3 class="h5 mb-2">Hunt narrowed</h3>
                  <p class="text-light opacity-75 mb-0">Measure and Radar answers sync so the group sees the same board.</p>
                </div>
