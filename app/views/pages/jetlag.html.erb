                        class: "img-fluid",
                        srcset: "#{asset_path('jetlag/03-join-400.webp')} 400w, #{asset_path('jetlag/03-join.webp')} 800w",
                        sizes: "(min-width: 992px) 20rem, min(100vw - 3rem, 18rem)",
                        loading: "lazy",
                        width: 800,
                        height: 1731 %>
