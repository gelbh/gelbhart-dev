                <button class="accordion-button collapsed bg-transparent text-light" type="button" data-bs-toggle="collapse" data-bs-target="#jetlagFaqOne" aria-expanded="false" aria-controls="jetlagFaqOne">
                  What is Jet Lag Map Companion?
                </button>
              </h3>
              <div id="jetlagFaqOne" class="accordion-collapse collapse" aria-labelledby="jetlagFaqHeadingOne" data-bs-parent="#jetlagFaq">
                <div class="accordion-body text-light opacity-75">
                  A live map companion for Hide + Seek sessions: seekers ask questions on the shared map; hiders answer, set hiding zones, and watch the hunt unfold in sync.
                </div>
              </div>
            </div>
            <div class="accordion-item bg-transparent border-secondary border-opacity-25">
              <h3 class="accordion-header" id="jetlagFaqHeadingTwo">
                <button class="accordion-button collapsed bg-transparent text-light" type="button" data-bs-toggle="collapse" data-bs-target="#jetlagFaqTwo" aria-expanded="false" aria-controls="jetlagFaqTwo">
                  Is it official?
                </button>
              </h3>
              <div id="jetlagFaqTwo" class="accordion-collapse collapse" aria-labelledby="jetlagFaqHeadingTwo" data-bs-parent="#jetlagFaq">
                <div class="accordion-body text-light opacity-75">
                  No. It is an unofficial fan companion — not affiliated with Jet Lag: The Game, Nebula, or the board game.
                </div>
              </div>
            </div>
            <div class="accordion-item bg-transparent border-secondary border-opacity-25">
              <h3 class="accordion-header" id="jetlagFaqHeadingThree">
                <button class="accordion-button collapsed bg-transparent text-light" type="button" data-bs-toggle="collapse" data-bs-target="#jetlagFaqThree" aria-expanded="false" aria-controls="jetlagFaqThree">
                  Is it free?
                </button>
              </h3>
              <div id="jetlagFaqThree" class="accordion-collapse collapse" aria-labelledby="jetlagFaqHeadingThree" data-bs-parent="#jetlagFaq">
                <div class="accordion-body text-light opacity-75">
                  Yes. Open the web app at jetlag.gelbhart.dev; the source is on GitHub.
                </div>
              </div>
            </div>
            <div class="accordion-item bg-transparent border-secondary border-opacity-25">
              <h3 class="accordion-header" id="jetlagFaqHeadingFour">
                <button class="accordion-button collapsed bg-transparent text-light" type="button" data-bs-toggle="collapse" data-bs-target="#jetlagFaqFour" aria-expanded="false" aria-controls="jetlagFaqFour">
                  Does it work on phones?
                </button>
              </h3>
              <div id="jetlagFaqFour" class="accordion-collapse collapse" aria-labelledby="jetlagFaqHeadingFour" data-bs-parent="#jetlagFaq">
                <div class="accordion-body text-light opacity-75">
                  Yes. It is built as a mobile-first PWA — add it to your home screen for a full-screen map.
                </div>
              </div>
            </div>
            <div class="accordion-item bg-transparent border-secondary border-opacity-25">
              <h3 class="accordion-header" id="jetlagFaqHeadingFive">
                <button class="accordion-button collapsed bg-transparent text-light" type="button" data-bs-toggle="collapse" data-bs-target="#jetlagFaqFive" aria-expanded="false" aria-controls="jetlagFaqFive">
                  Where is the code?
                </button>
              </h3>
              <div id="jetlagFaqFive" class="accordion-collapse collapse" aria-labelledby="jetlagFaqHeadingFive" data-bs-parent="#jetlagFaq">
                <div class="accordion-body text-light opacity-75">
                  The source is at <a href="https://github.com/gelbh/jetlag" target="_blank" rel="noopener noreferrer" class="text-primary">github.com/gelbh/jetlag</a>.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="card jetlag-card border-0 shadow mb-4 fade-in-view delay-5">
        <div class="card-body p-4">
          <p class="mb-0 text-light opacity-75 small">
            <i class="bx bx-info-circle me-1" aria-hidden="true"></i>
            Unofficial fan companion. Not affiliated with Jet Lag: The Game, Nebula, or the board game.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="modal fade jetlag-lightbox" id="jetlagImageModal" tabindex="-1" aria-labelledby="jetlagImageModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content bg-dark border-0">
      <div class="modal-header border-secondary border-opacity-25">
        <h2 class="modal-title h5 text-white" id="jetlagImageModalLabel">Screenshot</h2>
        <span class="jetlag-lightbox-counter text-light opacity-75 small ms-3" id="jetlagModalCounter" aria-hidden="true"></span>
        <span class="visually-hidden" id="jetlagModalStatus" aria-live="polite"></span>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <button type="button" class="jetlag-lightbox-nav jetlag-lightbox-prev" id="jetlagModalPrev" aria-label="Previous screenshot">
          <i class="bx bx-chevron-left" aria-hidden="true"></i>
        </button>
        <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="" class="jetlag-lightbox-image" id="jetlagModalImage" width="1" height="1">
        <button type="button" class="jetlag-lightbox-nav jetlag-lightbox-next" id="jetlagModalNext" aria-label="Next screenshot">
          <i class="bx bx-chevron-right" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    if (document.documentElement.dataset.jetlagLightboxListener === 'true') return;
    document.documentElement.dataset.jetlagLightboxListener = 'true';
    // Track bound nodes by identity, not a data attribute: Turbo restores
    // cached snapshots as clones that keep attributes but lose listeners.
    const boundModals = new WeakSet();

    document.addEventListener('turbo:load', function () {
      const imageModal = document.getElementById('jetlagImageModal');
      if (!imageModal || boundModals.has(imageModal)) return;

      boundModals.add(imageModal);
      const img = document.getElementById('jetlagModalImage');
      const title = imageModal.querySelector('.modal-title');
      const counter = document.getElementById('jetlagModalCounter');
      const status = document.getElementById('jetlagModalStatus');
      let items = [];
      let index = 0;

      function show(i) {
        if (!items.length) return;
        index = (i + items.length) % items.length;
        const item = items[index];
        const alt = item.getAttribute('data-alt') || '';
        img.src = item.getAttribute('data-image') || '';
        img.alt = alt;
        title.textContent = alt || 'Screenshot';
        counter.textContent = (index + 1) + ' / ' + items.length;
        status.textContent = (alt || 'Screenshot') + ', ' + (index + 1) + ' of ' + items.length;
        // Warm the neighbours so prev/next swaps without a blank frame
        [index - 1, index + 1].forEach(function (n) {
          new Image().src = items[(n + items.length) % items.length].getAttribute('data-image');
        });
      }

      imageModal.addEventListener('show.bs.modal', function (event) {
        const trigger = event.relatedTarget;
        if (!trigger) return;
        items = Array.from(document.querySelectorAll('[data-bs-target="#jetlagImageModal"]'));
        img.removeAttribute('width');
        img.removeAttribute('height');
        show(Math.max(items.indexOf(trigger), 0));
      });

      document.getElementById('jetlagModalPrev').addEventListener('click', function () { show(index - 1); });
      document.getElementById('jetlagModalNext').addEventListener('click', function () { show(index + 1); });
      imageModal.addEventListener('keydown', function (event) {
        if (event.key === 'ArrowLeft') show(index - 1);
        if (event.key === 'ArrowRight') show(index + 1);
      });
    });
  })();
</script>
