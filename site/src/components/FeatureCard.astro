---
import IconCircle from "./IconCircle.astro";

interface Props {
  icon: string;
  color: string;
  title: string;
  description: string;
  cardClasses?: string;
  animationDelay?: string;
}
const { icon, color, title, description, cardClasses = "", animationDelay = "" } = Astro.props;
---
<div class={`card ${cardClasses} border-0 shadow h-100 ${animationDelay}`}>
  <div class="card-body p-4">
    <IconCircle icon={icon} color={color} size="md" />
    <h4 class="h5 mb-3 mt-3">{title}</h4>
    <p class="text-muted mb-0">{description}</p>
  </div>
</div>
