---
import Logo from "./Logo.astro";
import ProjectNavIcon from "./ProjectNavIcon.astro";
import { requestPath } from "../lib/page";
import { projectsWithPages } from "../data/projects";

const path = requestPath(Astro.url.pathname);
const isCurrent = (url: string) => path === url;
const projectsActive = projectsWithPages.some((p) => isCurrent(p.linkUrl));
---
<header class="header bg-dark navbar navbar-expand-lg position-absolute navbar-sticky" data-bs-theme="dark">
  <div class="container px-3">
    <button class="navbar-toggler order-1" type="button" data-bs-toggle="modal" data-bs-target="#mobileMenu" aria-controls="mobileMenu" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse order-lg-1 d-none d-lg-flex" id="navbarNav">
      <ul class="navbar-nav">
        <li class="nav-item dropdown">
          <a class={`nav-link dropdown-toggle d-flex align-items-center ${projectsActive ? "active" : ""}`} href="#" id="projectsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bx bx-code-alt fs-lg me-1"></i>
            Projects
          </a>
          <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="projectsDropdown">
            {projectsWithPages.map((project) => (
              <li>
                <a href={project.linkUrl} class={`dropdown-item d-flex align-items-center ${isCurrent(project.linkUrl) ? "active" : ""}`}>
                  <ProjectNavIcon icon={project.icon} title={project.title} size={20} imgClass="me-2 project-dropdown-icon-img" iconClass="fs-lg me-2" />
                  {project.title}
                </a>
              </li>
            ))}
          </ul>
        </li>
        <li class="nav-item">
          <a href="/contact" class={`nav-link d-flex align-items-center ${isCurrent("/contact") ? "active" : ""}`}>
            <i class="bx bx-envelope fs-lg me-1"></i> Contact
          </a>
        </li>
      </ul>
    </div>
    <a href="/" class="navbar-brand order-2 order-lg-2 flex-shrink-1 mx-auto header-brand" aria-label="gelbhart.dev home">
      <div class="d-flex align-items-center justify-content-center">
        <Logo width={80} height={40} cssClass="header-logo" id="header" />
      </div>
    </a>
    <div class="order-3 order-lg-3 flex-shrink-0"></div>
  </div>
</header>
<div class="modal fade" id="mobileMenu" tabindex="-1" aria-labelledby="mobileMenuLabel" aria-hidden="true" data-bs-theme="dark">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content mobile-menu-popup">
      <div class="modal-header border-bottom border-secondary">
        <h5 class="modal-title d-flex align-items-center" id="mobileMenuLabel">
          <Logo width={60} height={30} cssClass="me-2" id="mobile-menu-logo" />
          <span class="text-white">Menu</span>
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <nav class="mobile-nav">
          <ul class="mobile-nav-list">
            <li class="mobile-nav-item">
              <a class={`mobile-nav-link ${projectsActive ? "active" : ""}`} href="#" role="button" data-bs-toggle="collapse" data-bs-target="#mobileProjectsDropdown" aria-expanded="false" aria-controls="mobileProjectsDropdown">
                <i class="bx bx-code-alt me-2"></i>
                <span>Projects</span>
                <i class="bx bx-chevron-down ms-auto mobile-nav-chevron"></i>
              </a>
              <div class="collapse" id="mobileProjectsDropdown">
                <ul class="mobile-nav-sublist">
                  {projectsWithPages.map((project) => (
                    <li>
                      <a href={project.linkUrl} class={`mobile-nav-sublink d-flex align-items-center ${isCurrent(project.linkUrl) ? "active" : ""}`} data-bs-dismiss="modal">
                        <ProjectNavIcon icon={project.icon} title={project.title} size={18} imgClass="me-2 project-dropdown-icon-img" iconClass="me-2" />
                        {project.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
            <li class="mobile-nav-item">
              <a href="/contact" class={`mobile-nav-link d-flex align-items-center ${isCurrent("/contact") ? "active" : ""}`} data-bs-dismiss="modal">
                <i class="bx bx-envelope me-2"></i>
                <span>Contact</span>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
</div>
